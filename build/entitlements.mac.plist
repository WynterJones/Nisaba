<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron needs a writable+executable JIT heap for V8. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- node-pty's spawn-helper is signed separately and loaded at runtime. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Browsing remote pages and checking for updates. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Agent CLIs run against folders the user nominates. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
