{
  "name": "nisaba",
  "version": "1.0.8",
  "description": "A desktop browser that turns design research into a reusable library",
  "main": "./out/main/index.js",
  "author": "WynterJones",
  "license": "MIT",
  "repository": "https://github.com/WynterJones/Nisaba",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "check:pty": "ELECTRON_RUN_AS_NODE=1 electron scripts/check-pty.cjs",
    "check:agents": "node --experimental-strip-types scripts/check-agents.mts",
    "check:design": "node --experimental-strip-types scripts/check-design-md.mts",
    "check:extract": "node --experimental-strip-types scripts/check-extract.mts",
    "check:stream": "node --experimental-strip-types scripts/check-stream.mts",
    "check:resources": "node --experimental-strip-types scripts/check-resources.mts",
    "check:preview": "node --experimental-strip-types scripts/check-preview.mts",
    "dist": "npm run build && electron-builder --mac --arm64 --x64 --publish never",
    "notarize": "bash scripts/notarize.sh",
    "release": "npm run build && electron-builder --mac --arm64 --x64 --publish never",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.3.9",
    "lucide-react": "^1.33.0",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "radix-ui": "^1.6.7",
    "react-router": "^8.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.4.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "node-pty@1.1.0": true,
    "fsevents@2.3.3": true
  }
}
